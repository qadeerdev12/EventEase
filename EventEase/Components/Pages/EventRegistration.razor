@page "/events/{Id:int}/register"
@inject EventService EventService

<PageTitle>Register · EventEase</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="events">Events</a></li>
        @if (_event is not null)
        {
            <li class="breadcrumb-item"><a href="@($"events/{_event.Id}")">@_event.Name</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">Register</li>
    </ol>
</nav>

@if (_event is null)
{
    <h1>Event not found</h1>
    <p><a href="events">Back to all events</a></p>
}
else if (_confirmed)
{
    <h1>You're registered!</h1>
    <div class="alert alert-success">
        Thanks, @_model.FullName. We've saved @_model.Guests seat(s) for you at
        <strong>@_event.Name</strong>. A confirmation will be sent to @_model.Email.
    </div>
    <a class="btn btn-primary" href="events">Browse more events</a>
}
else
{
    <h1>Register for @_event.Name</h1>
    <p class="text-muted">@_event.Date.ToString("f") · @_event.Location · @_event.SeatsLeft seats left</p>

    <EditForm Model="_model" OnValidSubmit="HandleValidSubmit" FormName="registration" class="col-md-6">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="fullName" class="form-label">Full name</label>
            <InputText id="fullName" class="form-control" @bind-Value="_model.FullName" />
            <ValidationMessage For="() => _model.FullName" />
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" type="email" class="form-control" @bind-Value="_model.Email" />
            <ValidationMessage For="() => _model.Email" />
        </div>
        <div class="mb-3">
            <label for="guests" class="form-label">Number of guests</label>
            <InputNumber id="guests" class="form-control" @bind-Value="_model.Guests" />
            <ValidationMessage For="() => _model.Guests" />
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        <button type="submit" class="btn btn-primary">Complete registration</button>
        <a class="btn btn-link" href="@($"events/{_event.Id}")">Cancel</a>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Event? _event;
    private Registration _model = new();
    private bool _confirmed;
    private string? _error;

    protected override void OnParametersSet() => _event = EventService.GetById(Id);

    private void HandleValidSubmit()
    {
        _error = null;
        if (EventService.Register(Id, _model))
        {
            _confirmed = true;
        }
        else
        {
            _error = "Sorry, there aren't enough seats left for that many guests.";
        }
    }
}
