@page "/events/{Id:int}"
@inject EventService EventService
@inject NavigationManager Navigation

@if (_event is not null)
{
    <PageTitle>@_event.Name · EventEase</PageTitle>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="events">Events</a></li>
            <li class="breadcrumb-item active" aria-current="page">@_event.Name</li>
        </ol>
    </nav>

    <h1>@_event.Name</h1>

    @if (_saved)
    {
        <div class="alert alert-success py-2" role="status">Event updated.</div>
    }

    <div class="row g-4">
        <div class="col-md-5">
            @* Two-way binding: the card only raises EventChanged with validated data, which we then save. *@
            <EventCard @bind-Event="_event" @bind-Event:after="SaveEvent" ShowActions="false" AllowEdit="true" />
        </div>
        <div class="col-md-7">
            <p>@_event.Description</p>
            <ul class="list-unstyled">
                <li><strong>When:</strong> @_event.Date.ToString("f")</li>
                <li><strong>Where:</strong> @_event.Location</li>
                <li><strong>Seats left:</strong> @_event.SeatsLeft of @_event.Capacity</li>
            </ul>
            <a class="btn btn-primary" href="@($"events/{_event.Id}/register")">Register for this event</a>
            <a class="btn btn-link" href="events">Back to events</a>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Event? _event;
    private bool _saved;

    protected override void OnParametersSet()
    {
        _saved = false;
        _event = EventService.GetById(Id);
        if (_event is null)
        {
            // Renders the app's Not Found page and returns HTTP 404 instead of an empty page.
            Navigation.NotFound();
        }
    }

    private void SaveEvent()
    {
        if (_event is null) return;

        _saved = EventService.Update(_event);
        // Reload the stored event so registrations and seat counts stay accurate.
        _event = EventService.GetById(Id);
    }
}
