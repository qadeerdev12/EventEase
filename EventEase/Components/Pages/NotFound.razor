@page "/not-found"
@layout MainLayout

<PageTitle>Page not found · EventEase</PageTitle>

<h1>Page not found</h1>
<p>
    Sorry, we couldn't find <code>/@Navigation.ToBaseRelativePath(Navigation.Uri)</code>.
    The event may have been removed, or the link may be incorrect.
</p>
<a class="btn btn-primary" href="events">Browse all events</a>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
}
